<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane alignment="center" hgap="10" prefWidth="450.0" vgap="10" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fafa.controller.records.AddEditRecordDialog">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Пользователь:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="userField" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Группа упражнений:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="exerciseGroupField" prefWidth="250.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Калории:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="caloriesField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Дата записи:" GridPane.columnIndex="0" GridPane.rowIndex="3" />

        <Label fx:id="errorLabel" textFill="RED" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4" />

        <Button fx:id="okButton" contentDisplay="CENTER" mnemonicParsing="false" prefWidth="100.0" text="ОК" GridPane.columnIndex="1" GridPane.halignment="RIGHT" GridPane.rowIndex="5" />
        <DatePicker fx:id="recordDateField" prefHeight="25.0" prefWidth="253.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </children>
    <columnConstraints>
        <ColumnConstraints hgrow="NEVER" minWidth="130.0" />
        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="30.0" />
        <RowConstraints minHeight="30.0" />
        <RowConstraints minHeight="30.0" />
        <RowConstraints minHeight="30.0" />
        <RowConstraints minHeight="25.0" />
        <RowConstraints minHeight="35.0" />
    </rowConstraints>
</GridPane>